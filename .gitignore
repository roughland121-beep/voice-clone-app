# Virtual environment (recreated by install.bat - don't commit it)
venv/

# PyInstaller build output (huge, and regenerated by build_portable_exe.bat)
build/
dist/
*.spec

# Python cache
__pycache__/
*.pyc

# The Urdu model files are multi-GB - GitHub blocks anything over 100MB anyway
urdu_model/

# User-specific settings and generated content - not part of the app itself
app_settings.json
saved_voice_samples/
*.wav
*.mp3
